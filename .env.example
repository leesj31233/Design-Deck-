# EngFlow — copy to .env.local and fill in what you need. Everything is optional:
# without these values the web app runs with local PGlite storage (dev) and the
# rule-based evaluator, and says so in Settings.

# PostgreSQL connection (Supabase, Neon, RDS, …). When unset, development uses
# PGlite (embedded PostgreSQL) in .data/pglite; production falls back to the
# browser-only demo mode unless ENGFLOW_DB=pglite is set.
DATABASE_URL=

# Server-side Claude evaluation, explanations and question generation.
# The key is only read on the server and never sent to the browser.
ANTHROPIC_API_KEY=

# Optional overrides
# ENGFLOW_MODEL=claude-opus-5-5
# Answer grading runs once per submit while the learner waits, so it uses a fast model.
# ENGFLOW_EVAL_MODEL=claude-haiku-5-5
# ENGFLOW_DB=pglite            # pglite | none
# ENGFLOW_PGLITE_DIR=.data/pglite
